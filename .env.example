# ============================================================================
# TechCiti Tutor Report Portal — Frontend Configuration
# Copy to .env.local for local development or .env.production for cPanel
# NEVER commit real values to version control
# ============================================================================

# Backend API URL - MUST use your production domain with https://
# Example: https://api.yourdomain.com/api  or  https://yourdomain.com/api
NEXT_PUBLIC_API_BASE_URL=https://yourdomain.com/api

# Optional: Override admin/tutor origins for CORS if different from API base URL
# NEXT_PUBLIC_ADMIN_ORIGIN=https://yourdomain.com
# NEXT_PUBLIC_TUTOR_ORIGIN=https://yourdomain.com

# Next.js settings
NODE_ENV=development
