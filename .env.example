# ------------------------------------------------------------------
# Frontend-only configuration for the TechCiti Tutor Report Portal.
# Copy to `.env.local`.
# ------------------------------------------------------------------

# Where the Express API lives. The frontend always talks to this backend;
# there is no mock mode.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Admin/tutor origins the backend allows (comma-separated). Mirrored from
# the backend's ADMIN_ORIGIN / TUTOR_ORIGIN for local development.
# NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:3001
# NEXT_PUBLIC_TUTOR_ORIGIN=http://localhost:3001
