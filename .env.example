# ------------------------------------------------------------------
# Frontend-only configuration for the TechCiti Tutor Report Portal.
# Copy to `.env.local` when you connect a real backend.
# ------------------------------------------------------------------

# Keep `true` to use the in-memory mock data in lib/mock-data.ts.
NEXT_PUBLIC_USE_MOCK_API=true

# Where the Express API lives (used only when the flag above is `false`).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Artificial latency for mock mode, in milliseconds (0 disables).
NEXT_PUBLIC_MOCK_LATENCY=380