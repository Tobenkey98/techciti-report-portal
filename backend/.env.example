# ==========================================================================
# TechCiti Tutor Report Portal — API configuration
# Copy this file to `.env` and adjust. Never commit the real `.env`.
# ==========================================================================

NODE_ENV=development
PORT=4000

# --------------------------------------------------------------------------
# Database (XAMPP / MariaDB). Create the database first (phpMyAdmin or:
#   CREATE DATABASE techciti_reports CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# --------------------------------------------------------------------------
DATABASE_URL="mysql://root:@localhost:3306/techciti_reports"

# --------------------------------------------------------------------------
# Authentication
# --------------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-characters"
JWT_EXPIRES_IN=8h
COOKIE_NAME=techciti_admin_session
COOKIE_SECURE=false

# Seed super admin (used by `npm run seed`)
SUPER_ADMIN_NAME="TechCiti Super Admin"
SUPER_ADMIN_EMAIL="admin@techciti.ng"
SUPER_ADMIN_PASSWORD="TechCiti2026!"

# --------------------------------------------------------------------------
ADMIN_ORIGIN=http://localhost:3000,http://localhost:3001
TUTOR_ORIGIN=http://localhost:3000,http://localhost:3001

# Public base URL of the tutor deployment. Used to build shareable portal links:
#   TUTOR_PORTAL_URL + "/t/" + accessToken
TUTOR_PORTAL_URL=http://localhost:3000

# --------------------------------------------------------------------------
# Behaviour
# --------------------------------------------------------------------------
DEFAULT_TIMEZONE=Africa/Lagos
# Month a report can be submitted for, at most, this many months ahead.
MAX_MONTHS_AHEAD=0
LOG_LEVEL=info
# Trust X-Forwarded-For behind a reverse proxy (set to 1 on Heroku/Render/nginx).
TRUST_PROXY=1

# --------------------------------------------------------------------------
# Uploads (bulk import). Max 5 MB.
# --------------------------------------------------------------------------
UPLOAD_MAX_MB=5

# --------------------------------------------------------------------------
# PDF generation (Puppeteer).
# Leave empty to auto-detect a locally installed Chrome/Edge.
# PUPPETEER_EXECUTABLE_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
# Comma-separated allowlists. One Next.js deployment commonly serves both
# /admin and /t/<token> from the same host, so the same origin can appear in
# both lists. Splitting the apps across two domains is still supported: list
# only each domain in its own list, and the namespaces stay mutually exclusive.
# CORS: /api/admin/* accepts ONLY the ADMIN_ORIGIN list, /api/tutor/* ONLY the TUTOR_ORIGIN list.