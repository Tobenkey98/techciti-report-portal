# ============================================================================
# TechCiti Tutor Report Portal — Backend Production Environment
# Copy to .env on your cPanel server
# NEVER commit real values to version control
# ============================================================================

NODE_ENV=production
PORT=4000

# Database - Use your cPanel MySQL details
# Format: mysql://username:password@hostname:3306/database_name
DATABASE_URL="mysql://your_db_user:your_db_password@localhost:3306/techciti_reports"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# MUST be at least 32 characters and kept secret
JWT_SECRET="your-32-character-secret-key-here"

# Session settings
JWT_EXPIRES_IN=8h
COOKIE_NAME=techciti_admin_session
COOKIE_SECURE=true  # MUST be true for HTTPS

# Seed super admin (used by npm run seed)
SUPER_ADMIN_NAME="TechCiti Super Admin"
SUPER_ADMIN_EMAIL="admin@techciti.ng"
SUPER_ADMIN_PASSWORD="TechCiti2026!"

# Origins - Update with your actual domain(s)
# One Next.js deployment commonly serves both /admin and /t/<token> from the same host
ADMIN_ORIGIN=https://yourdomain.com
TUTOR_ORIGIN=https://yourdomain.com

# Public base URL of the tutor deployment. Used to build shareable portal links:
#   TUTOR_PORTAL_URL + "/t/" + accessToken
TUTOR_PORTAL_URL=https://yourdomain.com

# Behavior settings
DEFAULT_TIMEZONE=Africa/Lagos
MAX_MONTHS_AHEAD=0
LOG_LEVEL=info
TRUST_PROXY=1  # Set to 1 when behind cPanel's reverse proxy

# Uploads (bulk import). Max 5 MB
UPLOAD_MAX_MB=5

# PDF generation (Puppeteer)
# Leave empty to auto-detect a locally installed Chrome/Edge
# PUPPETEER_EXECUTABLE_PATH=/path/to/chrome